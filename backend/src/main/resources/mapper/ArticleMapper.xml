<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tradesite.mapper.ArticleMapper">

    <resultMap id="BaseResultMap" type="com.tradesite.entity.Article">
        <id column="id" property="id"/>
        <result column="title_cn" property="titleCn"/>
        <result column="title_en" property="titleEn"/>
        <result column="content_cn" property="contentCn"/>
        <result column="content_en" property="contentEn"/>
        <result column="cover_image" property="coverImage"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM article ORDER BY create_time DESC
    </select>

    <select id="findPublished" resultMap="BaseResultMap">
        SELECT * FROM article WHERE status = 1 ORDER BY create_time DESC LIMIT #{limit}
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM article WHERE id = #{id}
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM article
    </select>

    <insert id="insert" parameterType="com.tradesite.entity.Article" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO article (title_cn, title_en, content_cn, content_en, cover_image, status)
        VALUES (#{titleCn}, #{titleEn}, #{contentCn}, #{contentEn}, #{coverImage}, #{status})
    </insert>

    <update id="update" parameterType="com.tradesite.entity.Article">
        UPDATE article
        SET title_cn = #{titleCn}, title_en = #{titleEn}, content_cn = #{contentCn},
            content_en = #{contentEn}, cover_image = #{coverImage}, status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM article WHERE id = #{id}
    </delete>

</mapper>
