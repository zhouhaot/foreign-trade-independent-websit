<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tradesite.mapper.InquiryMapper">

    <resultMap id="BaseResultMap" type="com.tradesite.entity.Inquiry">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="company_name" property="companyName"/>
        <result column="contact_name" property="contactName"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="message" property="message"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createTime"/>
        <result column="product_name" property="productName"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT i.*, COALESCE(p.name_cn, 'N/A') as product_name
        FROM inquiry i
        LEFT JOIN product p ON i.product_id = p.id
        ORDER BY i.create_time DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT i.*, COALESCE(p.name_cn, 'N/A') as product_name
        FROM inquiry i
        LEFT JOIN product p ON i.product_id = p.id
        WHERE i.id = #{id}
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM inquiry
    </select>

    <select id="countUnread" resultType="int">
        SELECT COUNT(*) FROM inquiry WHERE is_read = 0
    </select>

    <insert id="insert" parameterType="com.tradesite.entity.Inquiry" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO inquiry (product_id, company_name, contact_name, email, phone, message)
        VALUES (#{productId}, #{companyName}, #{contactName}, #{email}, #{phone}, #{message})
    </insert>

    <update id="markAsRead">
        UPDATE inquiry SET is_read = 1 WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM inquiry WHERE id = #{id}
    </delete>

</mapper>
