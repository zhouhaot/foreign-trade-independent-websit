<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tradesite.mapper.ProductCategoryMapper">

    <resultMap id="BaseResultMap" type="com.tradesite.entity.ProductCategory">
        <id column="id" property="id"/>
        <result column="name_cn" property="nameCn"/>
        <result column="name_en" property="nameEn"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM product_category ORDER BY sort_order ASC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM product_category WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.tradesite.entity.ProductCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_category (name_cn, name_en, sort_order)
        VALUES (#{nameCn}, #{nameEn}, #{sortOrder})
    </insert>

    <update id="update" parameterType="com.tradesite.entity.ProductCategory">
        UPDATE product_category
        SET name_cn = #{nameCn}, name_en = #{nameEn}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product_category WHERE id = #{id}
    </delete>

</mapper>
