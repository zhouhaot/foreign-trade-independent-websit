      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a href=\"#/dashboard\" class=\"ds-nav-item ds-selected\" aria-current=\"page\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M3 10l9-7 9 7v10H3zM9 20v-7h6v7\"/></svg>工作台</a><a href=\"#/orders\" class=\"ds-nav-item\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7\"/></svg>订单查询</a></nav>",
      "css": ".ds-nav{width:224px;background:var(--nav-bg,#f0ecfb)}.ds-nav-item{display:flex;align-items:center;gap:12px;margin:0 16px 6px;padding:12px 14px;border-radius:8px;background:none;color:var(--text-sub,#6b647d);font-family:inherit;font-size:13px;line-height:1.5;text-decoration:none;cursor:pointer;transition:background-color var(--duration-fast,140ms),color var(--duration-fast,140ms)}.ds-nav-icon{width:18px;height:18px;flex-shrink:0}.ds-nav-item:hover{background:var(--nav-bg-deep,#e8e0fa);color:var(--primary,#6542d9)}.ds-nav-item.ds-selected{background:var(--primary,#6542d9);color:#fff;font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--primary,#6542d9);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
