      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--text,#211d38);font-family:inherit;font-size:13px}.ds-input{height:38px;padding:0 10px;border:1px solid var(--border-control,#8b809f);border-radius:var(--radius-control,8px);background:#fff;color:var(--text,#211d38);font-family:inherit;font-size:13px;outline:none;caret-color:var(--primary,#6542d9);transition:border-color var(--duration-fast,140ms),background-color var(--duration-fast,140ms)}.ds-input::placeholder{color:var(--text-sub,#6b647d);opacity:1}.ds-input:focus,.ds-input:focus-visible{border-color:var(--primary,#6542d9);box-shadow:0 0 0 2px rgba(101,66,217,.16)}.ds-input[readonly]{background:var(--surface-subtle,#faf9fd);color:var(--text-sub,#6b647d)}.ds-input[aria-invalid=\"true\"]{border-color:var(--red,#c0353f)}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
